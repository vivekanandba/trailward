# Feedback store (spec 29, primary): Neon connection string for the
# INSERT-only role created by db/feedback-schema.sql. Safe to expose in the
# built bundle — the role can only insert feedback rows. Also add this as a
# GitHub Actions secret named VITE_NEON_FEEDBACK_URL so Pages builds get it.
VITE_NEON_FEEDBACK_URL=postgres://trailward_writer:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Dev-side readback (never in the browser, never committed): the OWNER
# connection string, used by `npm run feedback:list`.
# TRAILWARD_DATABASE_URL=postgres://neondb_owner:...@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Web3Forms access key for the feedback form (free, no account needed to create).
# Get one at https://web3forms.com — it's tied to the email you want feedback sent to.
# Copy this file to .env and fill in. Vite only exposes vars prefixed with VITE_.
VITE_WEB3FORMS_KEY=your-access-key-here
